{
  "name": "@resume-agent/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:pro": "node scripts/pro-smoke.mjs",
    "check:search": "tsx scripts/pro-search-check.mjs",
    "check:system": "tsx scripts/pro-system-check.mjs",
    "backup": "node scripts/backup.mjs",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "@resume-agent/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.51.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0"
  }
}
