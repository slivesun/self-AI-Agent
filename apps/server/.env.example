# 复制为 .env 后填写；不要提交真实密钥
# 火山方舟 API Key（也可以在后台「模型设置」里填写，优先级：环境变量 > 后台设置）
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-mini-260428

# 服务监听：默认仅本机；部署到服务器时设为 0.0.0.0 并置于反向代理/HTTPS 之后
HOST=127.0.0.1
PORT=3001

# JWT 签名密钥：生产环境必须显式设置（>=16 位）；不设置会在数据目录自动生成
JWT_SECRET=

# 首次启动管理员口令：不设置则用 admin123 并强制首次登录改密
ADMIN_INIT_PASSWORD=

# 匿名访客数据保留天数（<=0 关闭），只清理未注册访客的会话
DATA_RETENTION_DAYS=180

# 注册账号每日提问总上限
DAILY_MESSAGES_PER_USER=200
