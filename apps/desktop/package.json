{
  "name": "@resume-agent/desktop",
  "version": "0.1.0",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.resume.agent",
    "productName": "AI简历助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/**/*",
      "bridge/**/*",
      "ipc/**/*",
      "windows/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
