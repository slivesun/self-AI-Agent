{
  "name": "resume-agent",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @resume-agent/server run dev",
    "dev:web": "pnpm --filter @resume-agent/web run dev",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "pnpm --filter @resume-agent/web run build",
    "build:server": "pnpm --filter @resume-agent/server run build",
    "start": "pnpm --filter @resume-agent/server run start",
    "electron": "pnpm --filter @resume-agent/desktop run dev",
    "pack": "pnpm --filter @resume-agent/desktop run dist",
    "pack:dir": "pnpm --filter @resume-agent/desktop run dist:dir"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
